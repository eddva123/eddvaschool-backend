# PostgreSQL — copy to .env and set PGPASSWORD to your Postgres password

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=eddva_edtech
PGSSLMODE=disable

# Or use a connection string instead of PG* (comment out PG* if you use this):
# DATABASE_URL=postgres://postgres:your_postgres_password@localhost:5432/eddva_edtech

PORT=5000
NODE_ENV=development

JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_EXPIRE=7

CLIENT_URL=http://localhost:5173
